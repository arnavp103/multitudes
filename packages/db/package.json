{
  "name": "@multitudes/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./src/client.ts"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./src/schema.ts"
    },
    "./runs": {
      "types": "./dist/runs.d.ts",
      "default": "./src/runs.ts"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "default": "./src/queue.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "push": "pnpm with-env drizzle-kit push",
    "studio": "pnpm with-env drizzle-kit studio",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenvx run -f ../../.env --",
    "generate": "drizzle-kit generate --config drizzle.agents.config.ts",
    "migrate": "pnpm with-env drizzle-kit migrate --config drizzle.agents.config.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@multitudes/observability": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.16.3",
    "pg-boss": "12.37.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@multitudes/eslint-config": "workspace:*",
    "@multitudes/prettier-config": "workspace:*",
    "@multitudes/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "^4.22.5",
    "typescript": "catalog:"
  },
  "prettier": "@multitudes/prettier-config"
}
