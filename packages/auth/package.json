{
  "name": "@multitudes/auth",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./env.ts",
    "./permissions": "./src/permissions.ts",
    "./testing": "./src/testing.ts"
  },
  "license": "MIT",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "generate": "dotenvx run -f ../../.env -- auth generate --config script/auth-cli.ts --output ../db/src/auth-schema.ts --yes",
    "typecheck": "tsc --noEmit",
    "test:integration": "node --import tsx --test test/integration.test.ts",
    "bootstrap-admin": "node --import tsx script/bootstrap-admin.ts"
  },
  "dependencies": {
    "@multitudes/db": "workspace:*",
    "@multitudes/observability": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "better-auth": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@multitudes/eslint-config": "workspace:*",
    "@multitudes/prettier-config": "workspace:*",
    "@multitudes/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "auth": "1.7.7",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "^4.22.5",
    "typescript": "catalog:"
  },
  "prettier": "@multitudes/prettier-config"
}
