{
  "name": "@multitudes/studio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../tooling/version.mjs pnpm with-env next build",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "dev": "node ../../tooling/version.mjs pnpm with-env next dev",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "start": "pnpm with-env next start --port 3001",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenvx run -f ../../.env --"
  },
  "dependencies": {
    "@multitudes/agent": "workspace:*",
    "@multitudes/auth": "workspace:*",
    "@multitudes/db": "workspace:*",
    "@multitudes/evals": "workspace:*",
    "@multitudes/observability": "workspace:*",
    "@multitudes/ui": "workspace:*",
    "better-auth": "catalog:",
    "next": "^16.4.0",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@multitudes/eslint-config": "workspace:*",
    "@multitudes/prettier-config": "workspace:*",
    "@multitudes/tailwind-config": "workspace:*",
    "@multitudes/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "eslint": "catalog:",
    "jiti": "^2.7.0",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:"
  },
  "prettier": "@multitudes/prettier-config"
}
