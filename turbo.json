{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^dev"],
      "cache": false,
      "persistent": false
    },
    "format": {
      "outputs": [".cache/.prettiercache"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": [".cache/.eslintcache"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    },
    "push": {
      "cache": false,
      "interactive": true
    },
    "studio": {
      "cache": false,
      "persistent": true
    },
    "ui-add": {
      "cache": false,
      "interactive": true
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    }
  },
  "globalEnv": [
    "POSTGRES_URL",
    "AUTH_DISCORD_ID",
    "AUTH_DISCORD_SECRET",
    "AUTH_SECRET",
    "PORT",
    "STUDIO_URL",
    "AGENT_MODEL_ID",
    "AGENT_PROVIDER",
    "AGENT_CODE_VERSION",
    "WORKER_CONCURRENCY",
    "LOG_LEVEL",
    "APP_VERSION",
    "WEBAPP_URL",
    "AUTH_PRODUCTION_URL",
    "STUDIO_AUTH_PRODUCTION_URL"
  ],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "npm_lifecycle_event",
    "OTEL_*",
    "AWS_*",
    "TEST_POSTGRES_URL",
    "NEXT_RUNTIME",
    "GEMINI_API_KEY",
    "NEXT_OTEL_VERBOSE",
    "NEXT_OTEL_FETCH_DISABLED"
  ]
}
