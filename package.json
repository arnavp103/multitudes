{
  "name": "multitudes",
  "private": true,
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^10.34.6"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "node tooling/version.mjs turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "auth:generate": "pnpm -F @multitudes/auth generate",
    "db:push": "turbo -F @multitudes/db push",
    "db:studio": "turbo -F @multitudes/db studio",
    "dev": "node tooling/version.mjs turbo watch dev --continue",
    "dev:webapp": "node tooling/version.mjs turbo watch dev -F @multitudes/webapp...",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "node tooling/version.mjs turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "node tooling/version.mjs turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@1.13.0",
    "syncpack": "syncpack lint",
    "prepare": "husky",
    "postinstall": "node tooling/version.mjs",
    "typecheck": "node tooling/version.mjs turbo run typecheck",
    "ui-add": "turbo run ui-add",
    "dev:studio": "node tooling/version.mjs turbo watch dev -F @multitudes/studio...",
    "dev:backend": "node tooling/version.mjs turbo watch dev -F @multitudes/backend...",
    "db:generate": "pnpm -F @multitudes/db generate",
    "db:migrate": "pnpm -F @multitudes/db migrate",
    "test": "pnpm test:unit",
    "test:unit": "pnpm test:build && node tooling/version.mjs turbo run test:unit",
    "test:integration": "node tooling/version.mjs turbo run test:integration",
    "dev:email": "pnpm --filter @multitudes/email dev",
    "version:stamp": "node tooling/version.mjs",
    "test:build": "node --test tooling/version.test.mjs",
    "build:apps": "node tooling/version.mjs turbo run build --filter=@multitudes/studio... --filter=@multitudes/webapp... --filter=@multitudes/backend...",
    "test:health": "node --test tooling/health.integration.test.mjs",
    "test:e2e": "node tooling/version.mjs pnpm --filter @multitudes/dev test:e2e",
    "dev:up": "node tooling/version.mjs pnpm --filter @multitudes/dev up",
    "dev:login": "pnpm --filter @multitudes/dev login",
    "dev:down": "pnpm --filter @multitudes/dev down",
    "auth:bootstrap-admin": "pnpm exec dotenvx run -f .env -- pnpm --filter @multitudes/auth bootstrap-admin"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@dotenvx/dotenvx": "^2.34.2",
    "@multitudes/cli": "workspace:*",
    "@multitudes/prettier-config": "workspace:*",
    "@turbo/gen": "^2.11.7",
    "husky": "^9.1.7",
    "prettier": "catalog:",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  },
  "prettier": "@multitudes/prettier-config"
}
