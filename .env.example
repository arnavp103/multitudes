# Copy this file to `.env` and replace the example values with your own.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# PostgreSQL connection string (the example uses a Supabase pooler).
# POSTGRES_URL="postgres://postgres.[USERNAME]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?workaround=supabase-pooler.vercel"

# Generate a secret with: openssl rand -base64 32
# @see https://www.better-auth.com/docs/installation
# AUTH_SECRET='replace-with-a-generated-secret'

# Discord OAuth app credentials
# @see https://www.better-auth.com/docs/authentication/discord
# AUTH_DISCORD_ID=''
# AUTH_DISCORD_SECRET=''
# Agent worker and internal studio (separate from webapp on port 3000)
# STUDIO_URL="http://localhost:3001"
# STUDIO_ALLOWED_EMAILS="you@example.com"
# AGENT_PROVIDER="bedrock"
# AGENT_MODEL_ID="your-provider-model-id"
# AGENT_CODE_VERSION="local"
# WORKER_CONCURRENCY="2"
# LOG_LEVEL="info"
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_RESOURCE_ATTRIBUTES="service.namespace=multitudes,deployment.environment.name=development"
# AWS_REGION="us-east-1"
# Use the AWS credential chain for Bedrock, or OPENAI_API_KEY for OpenAI.
# OPENAI_API_KEY=""
